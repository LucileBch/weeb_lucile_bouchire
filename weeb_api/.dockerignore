# Secrets: provided at runtime, never baked into the image
.env

# Local virtualenv (rebuilt from requirements.txt in the image)
env/

# Generated / local-only files
**/__pycache__/
**/*.pyc
**/.DS_Store
api/staticfiles/
api/media/
**/*.sqlite3

# Tests: run in CI, not needed in the production image
**/test_*.py
api/conftest.py
pytest.ini
.coveragerc
**/.pytest_cache/
**/.coverage
requirements-dev.txt
