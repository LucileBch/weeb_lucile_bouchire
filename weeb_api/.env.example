# ===== Backend environment variables ===== #
# Django secret key
SECRET_KEY=

# ===== production only ===== #
# comma-separated, no spaces (e.g. weeb-api.onrender.com)
ALLOWED_HOSTS=
# comma-separated, no spaces (e.g. https://weeb.vercel.app)
CORS_ALLOWED_ORIGINS=

# ===== email ===== #
DEFAULT_EMAIL=

EMAIL_HOST =
EMAIL_HOST_USER =
EMAIL_HOST_PASSWORD =
EMAIL_PORT =

# ===== jwt and cookies ===== #
JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_LIFETIME=
JWT_REFRESH_TOKEN_LIFETIME=
JWT_COOKIE_SECURE=

# ===== cloudinary ===== #
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PREFIX=

# ===== supabase ===== #
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
# optional, default: require (set to "disable" for a local Postgres without SSL)
# DB_SSLMODE=require
